# Скопируй как .env и подставь свои значения. НЕ коммить .env.

# === Любой OpenAI-совместимый провайдер (высший приоритет) ===
# OpenRouter, LM Studio, vLLM, Together, локальные и т.п. Если задан OPENAI_BASE_URL —
# используется вместо Azure/Gemini.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_HTTP_TIMEOUT=45

# === Gemini (третий приоритет, после generic OpenAI и Azure) ===
# Используется, если OPENAI_BASE_URL и AZURE_OPENAI_API_KEY не заданы.
GEMINI_API_KEY=your-gemini-api-key-here
# DEFAULT_MODEL=3.1-flash-lite  # раскомментируй чтобы переопределить модель

# === Azure OpenAI (второй приоритет, после generic OpenAI) ===
# Если AZURE_OPENAI_API_KEY задан (и нет OPENAI_BASE_URL) — использует Azure gpt-5-mini.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT/openai/v1
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# Для gpt-5-mini не ставь слишком мало (типа 120) — часто пустой ответ.
AZURE_MAX_TOKENS=800

# Таймаут HTTP к Foundry (секунды)
AZURE_HTTP_TIMEOUT=45

# Пусто = не отправлять temperature
AZURE_TEMPERATURE=

# --- Голос модели (gpt-5-mini — reasoning-модель) ---
# minimal/low/none — чтобы reasoning-токены не съедали бюджет и ответ не был пустым/сухим.
# Если деплой не знает параметр — сервис сам повторит запрос без него.
AZURE_REASONING_EFFORT=minimal

# --- Память ---
# Файловая память (факты + история) работает ВСЕГДА, даже без Qdrant.
# Каталог для facts.json / history.json (относительно observer-service).
MEMORY_DIR=./data

# Фоновое LLM-извлечение фактов из чата (true/false). Команда «запомни X» работает всегда.
AUTO_FACT_EXTRACTION=true

# --- Семантический слой (опционально, поверх файловой памяти) ---
# Включается только если RAG_ENABLED=true, поднят Qdrant и задан deployment эмбеддингов.
RAG_ENABLED=false
QDRANT_URL=http://127.0.0.1:6333
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Debug / MCP (Claude через SSH-туннель) ---
# Включает POST /chat, GET /logs, REST /send_chat и монтирует FastMCP на /mcp.
DEBUG_ENDPOINTS=true
# MCP_ENABLED=true   # можно включить MCP отдельно от debug REST
# Опциональный shared secret: Authorization: Bearer … или X-Debug-Key
DEBUG_API_KEY=

# --- Отправка в игровой чат (send_chat) ---
# rcon | mod | none
# rcon — быстро (нужен enable-rcon в server.properties)
# mod  — POST на inbound HTTP мода (127.0.0.1:8081), после деплоя jar
SEND_CHAT_BACKEND=rcon
SEND_CHAT_PREFIX=Claude
SEND_CHAT_TRIGGER_BOGA=true
BOGA_CHAT_PREFIX=Бог А

# Из Docker-контейнера хост VM = host.docker.internal (см. docker-compose extra_hosts)
RCON_HOST=host.docker.internal
RCON_PORT=25575
RCON_PASSWORD=

MOD_CHAT_URL=http://host.docker.internal:8081/broadcast
MOD_CHAT_API_KEY=
