+    private static void circuitsChain(Consumer<FinishedRecipe> provider) {
+        // LV - Dodik Board
+        GTRecipeTypes.ASSEMBLER_RECIPES.recipeBuilder("craft_dodik_board")
+                .inputItems(plate, SkufMaterials.honestSteel)
+                .inputItems(foil, SkufMaterials.honestSteel, 2)
+                .inputItems(wireGtSingle, SkufMaterials.honestSteel, 2)
+                .circuitMeta(1)
+                .outputItems(SkufItems.DODIK_BOARD)
+                .duration(160)
+                .EUt(16)
+                .save(provider);
+
+        // MV - Lyudskaya Board (consumes Dodik Board)
+        GTRecipeTypes.ASSEMBLER_RECIPES.recipeBuilder("craft_lyudskaya_board")
+                .inputItems(SkufItems.DODIK_BOARD)
+                .inputItems(plate, SkufMaterials.pokhuit)
+                .inputItems(wireGtSingle, SkufMaterials.pokhuit, 2)
+                .inputItems(dust, SkufMaterials.correctMatter)
+                .circuitMeta(2)
+                .outputItems(SkufItems.LYUDSKAYA_BOARD)
+                .duration(200)
+                .EUt(48)
+                .save(provider);
+
+        // HV - Zapizdosh Mainframe (consumes Lyudskaya Board)
+        GTRecipeTypes.ASSEMBLER_RECIPES.recipeBuilder("craft_zapizdosh_mainframe")
+                .inputItems(SkufItems.LYUDSKAYA_BOARD)
+                .inputItems(plate, SkufMaterials.correctMatter)
+                .inputItems(wireGtSingle, SkufMaterials.crystallizedDodikSweat, 2)
+                .inputItems(gem, SkufMaterials.correctMatter)
+                .circuitMeta(3)
+                .outputItems(SkufItems.ZAPIZDOSH_MAINFRAME)
+                .duration(240)
+                .EUt(128)
+                .save(provider);
+    }
